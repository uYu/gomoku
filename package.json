{
  "name": "gomoku-atelier",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5178",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "start": "node --experimental-strip-types server/production.ts",
    "test:server": "node --experimental-strip-types --test tests/server/*.test.ts",
    "build:native": "sh scripts/build-native.sh",
    "build:wasm": "sh scripts/build-wasm.sh",
    "test:native": "node --experimental-strip-types --test tests/native/*.test.ts",
    "training:prepare": "python3 scripts/prepare-training.py --rule renju",
    "training:run": "python3 scripts/train-policy.py",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "analyze": "node --experimental-strip-types scripts/analyze.ts",
    "assets:verify": "python3 scripts/verify-assets.py",
    "training:openings": "node --experimental-strip-types scripts/prepare-openings.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "GPL-3.0-or-later"
}
